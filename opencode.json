{
  "$schema": "https://opencode.ai/config.json",
  "memory_group": "graphiti",
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "ask"
    },
    {
      "action": "file_read",
      "resource": "/tmp/**",
      "effect": "allow"
    }
  ]
}
